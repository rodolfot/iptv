    <!-- About / Legal -->
    <string name="about_title">À propos de TartaTV</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_intro">TartaTV est une application lecteur qui diffuse des listes IPTV au standard Xtream Codes fournies par vous-même. Elle fonctionne comme un lecteur : elle se connecte au serveur dont vous saisissez les identifiants et lit le contenu qu\'il renvoie.\n\nElle ne distribue, n\'héberge, n\'indexe ni ne vend aucun contenu — il n\'y a aucun catalogue intégré ni liste pré-installée. La lecture dépend entièrement de la liste que vous fournissez.\n\nFonctionnalités : chaînes en direct avec guide des programmes (EPG), films et séries avec synopsis et jaquette, reprise de lecture, favoris, liste à voir plus tard, contrôle parental par code PIN et profils multiples. Tout est stocké localement sur votre appareil — pas de serveur à nous, pas d\'analytique, pas de publicité.</string>
    <string name="about_terms">Conditions d\'utilisation</string>
    <string name="about_privacy">Politique de confidentialité</string>
    <string name="about_open_source">Bibliothèques open source</string>
    <string name="about_crash_log">Diagnostic (journaux locaux)</string>
    <string name="crash_log_title">Diagnostic</string>
