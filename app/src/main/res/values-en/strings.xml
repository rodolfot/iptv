    <!-- About / Legal -->
    <string name="about_title">About TartaTV</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_intro">TartaTV is a player app that streams IPTV lists in the Xtream Codes standard provided by you. It works as a reader: it connects to the server whose credentials you enter and plays whatever the server returns.\n\nIt does not distribute, host, index or sell any content — there is no built-in catalog and no preloaded list. Playback depends entirely on the list you supply.\n\nFeatures: live channels with electronic program guide (EPG), movies and series with synopsis and cover art, continue watching, favorites, watch-later list, parental PIN control and multiple profiles. Everything is stored locally on your device — no server of our own, no analytics, no ads.</string>
    <string name="about_terms">Terms of Use</string>
    <string name="about_privacy">Privacy Policy</string>
    <string name="about_open_source">Open source libraries</string>
