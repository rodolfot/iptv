<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Iptv" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="Theme.Iptv.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/background</item>
        <item name="postSplashScreenTheme">@style/Theme.Iptv</item>
    </style>
</resources>
